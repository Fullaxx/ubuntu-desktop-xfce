# Applications > Ubuntu Desktop > Graphics (see ubuntu-desktop.menu)
# /app/scripts/krita.sh installs Krita on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Krita
Comment=Installs Krita on first use if needed, then starts it
Exec=/app/scripts/krita.sh
Icon=applications-graphics
Terminal=false
Categories=X-UbuntuDesktop-Graphics;
