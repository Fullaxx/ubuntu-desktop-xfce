# Applications > Ubuntu Desktop > AV (see ubuntu-desktop.menu)
# /app/scripts/openshot.sh installs OpenShot on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=OpenShot
Comment=Installs OpenShot on first use if needed, then starts it
Exec=/app/scripts/openshot.sh
Icon=video-x-generic
Terminal=false
Categories=X-UbuntuDesktop-AV;
