# Applications > Ubuntu Desktop > File Managers (see ubuntu-desktop.menu)
# /app/scripts/nemo.sh installs Nemo on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Nemo
Comment=Installs Nemo on first use if needed, then starts it
Exec=/app/scripts/nemo.sh
Icon=system-file-manager
Terminal=false
Categories=X-UbuntuDesktop-FileManagers;
