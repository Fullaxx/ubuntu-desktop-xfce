# Applications > Ubuntu Desktop > Utilities (see ubuntu-desktop.menu)
# /app/scripts/kcalc.sh installs KCalc on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=KCalc
Comment=Installs KCalc on first use if needed, then starts it
Exec=/app/scripts/kcalc.sh
Icon=applications-utilities
Terminal=false
Categories=X-UbuntuDesktop-Utilities;
