# Applications > Ubuntu Desktop > Utilities > Calculators (see ubuntu-desktop.menu)
# /app/scripts/kcalc.sh installs KCalc on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=KCalc
Comment=Installs KCalc on first use if needed, then starts it
Exec=/app/scripts/kcalc.sh
Icon=accessories-calculator
Terminal=false
Categories=X-UbuntuDesktop-Calculators;
