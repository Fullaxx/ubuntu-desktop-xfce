# Applications > Ubuntu Desktop > AV (see ubuntu-desktop.menu)
# /app/scripts/winff.sh installs WinFF on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=WinFF
Comment=Installs WinFF on first use if needed, then starts it
Exec=/app/scripts/winff.sh
Icon=video-x-generic
Terminal=false
Categories=X-UbuntuDesktop-AV;
