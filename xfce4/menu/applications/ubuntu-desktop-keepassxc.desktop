# Applications > Ubuntu Desktop > Utilities > Passwords (see ubuntu-desktop.menu)
# /app/scripts/keepassxc.sh installs KeePassXC on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=KeePassXC
Comment=Installs KeePassXC on first use if needed, then starts it
Exec=/app/scripts/keepassxc.sh
Icon=dialog-password
Terminal=false
Categories=X-UbuntuDesktop-Passwords;
