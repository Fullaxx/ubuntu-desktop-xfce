# Applications > Ubuntu Desktop > Network > BitTorrent (see ubuntu-desktop.menu)
# /app/scripts/qbittorrent.sh installs qBittorrent on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=qBittorrent
Comment=Installs qBittorrent on first use if needed, then starts it
Exec=/app/scripts/qbittorrent.sh
Icon=network-transmit-receive
Terminal=false
Categories=X-UbuntuDesktop-BitTorrent;
