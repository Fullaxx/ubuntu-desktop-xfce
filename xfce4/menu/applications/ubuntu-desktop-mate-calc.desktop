# Applications > Ubuntu Desktop > Utilities > Calculators (see ubuntu-desktop.menu)
# /app/scripts/mate-calc.sh installs MATE Calculator on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=MATE Calculator
Comment=Installs MATE Calculator on first use if needed, then starts it
Exec=/app/scripts/mate-calc.sh
Icon=accessories-calculator
Terminal=false
Categories=X-UbuntuDesktop-Calculators;
