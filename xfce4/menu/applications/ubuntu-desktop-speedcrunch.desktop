# Applications > Ubuntu Desktop > Utilities (see ubuntu-desktop.menu)
# /app/scripts/speedcrunch.sh installs SpeedCrunch on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=SpeedCrunch
Comment=Installs SpeedCrunch on first use if needed, then starts it
Exec=/app/scripts/speedcrunch.sh
Icon=applications-utilities
Terminal=false
Categories=X-UbuntuDesktop-Utilities;
