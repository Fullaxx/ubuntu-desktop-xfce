# Applications > Ubuntu Desktop > Terminals (see ubuntu-desktop.menu)
# /app/scripts/kitty.sh installs kitty on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=kitty
Comment=Installs kitty on first use if needed, then starts it
Exec=/app/scripts/kitty.sh
Icon=utilities-terminal
Terminal=false
Categories=X-UbuntuDesktop-Terminals;
