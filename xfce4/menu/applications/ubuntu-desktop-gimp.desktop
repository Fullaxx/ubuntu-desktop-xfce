# Applications > Ubuntu Desktop > Graphics (see ubuntu-desktop.menu)
# /app/scripts/gimp.sh installs GIMP on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=GIMP
Comment=Installs GIMP on first use if needed, then starts it
Exec=/app/scripts/gimp.sh
Icon=applications-graphics
Terminal=false
Categories=X-UbuntuDesktop-Graphics;
