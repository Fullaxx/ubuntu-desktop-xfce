# Applications > Ubuntu Desktop > Utilities (see ubuntu-desktop.menu)
# /app/scripts/qalculate.sh installs Qalculate! on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Qalculate!
Comment=Installs Qalculate! on first use if needed, then starts it
Exec=/app/scripts/qalculate.sh
Icon=applications-utilities
Terminal=false
Categories=X-UbuntuDesktop-Utilities;
