# Applications > Ubuntu Desktop > Editors (see ubuntu-desktop.menu)
# /app/scripts/bluefish.sh installs Bluefish on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Bluefish
Comment=Installs Bluefish on first use if needed, then starts it
Exec=/app/scripts/bluefish.sh
Icon=accessories-text-editor
Terminal=false
Categories=X-UbuntuDesktop-Editors;
