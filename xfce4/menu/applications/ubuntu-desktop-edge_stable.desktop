# Applications > Ubuntu Desktop > Network > Browsers (see ubuntu-desktop.menu)
# /app/scripts/edge_stable.sh installs Microsoft Edge on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Microsoft Edge
Comment=Installs Microsoft Edge on first use if needed, then starts it
Exec=/app/scripts/edge_stable.sh
Icon=web-browser
Terminal=false
Categories=X-UbuntuDesktop-Browsers;
