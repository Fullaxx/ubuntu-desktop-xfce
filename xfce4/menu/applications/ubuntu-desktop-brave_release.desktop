# Applications > Ubuntu Desktop > Network > Browsers (see ubuntu-desktop.menu)
# /app/scripts/brave_release.sh installs Brave on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Brave
Comment=Installs Brave on first use if needed, then starts it
Exec=/app/scripts/brave_release.sh
Icon=web-browser
Terminal=false
Categories=X-UbuntuDesktop-Browsers;
