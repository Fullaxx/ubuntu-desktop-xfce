# Applications > Ubuntu Desktop > Network > Chat (see ubuntu-desktop.menu)
# /app/scripts/discord.sh installs Discord on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Discord
Comment=Installs Discord on first use if needed, then starts it
Exec=/app/scripts/discord.sh
Icon=im-message-new
Terminal=false
Categories=X-UbuntuDesktop-Chat;
