# Applications > Ubuntu Desktop > File Managers (see ubuntu-desktop.menu)
# /app/scripts/krusader.sh installs Krusader on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Krusader
Comment=Installs Krusader on first use if needed, then starts it
Exec=/app/scripts/krusader.sh
Icon=system-file-manager
Terminal=false
Categories=X-UbuntuDesktop-FileManagers;
