# Applications > Ubuntu Desktop > File Managers (see ubuntu-desktop.menu)
# /app/scripts/pcmanfm.sh installs PCManFM on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=PCManFM
Comment=Installs PCManFM on first use if needed, then starts it
Exec=/app/scripts/pcmanfm.sh
Icon=system-file-manager
Terminal=false
Categories=X-UbuntuDesktop-FileManagers;
