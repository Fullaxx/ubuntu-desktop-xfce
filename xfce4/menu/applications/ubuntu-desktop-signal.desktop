# Applications > Ubuntu Desktop > Network > Chat (see ubuntu-desktop.menu)
# /app/scripts/signal.sh installs Signal on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Signal
Comment=Installs Signal on first use if needed, then starts it
Exec=/app/scripts/signal.sh
Icon=im-message-new
Terminal=false
Categories=X-UbuntuDesktop-Chat;
