# Applications > Ubuntu Desktop > Editors (see ubuntu-desktop.menu)
# /app/scripts/vscode.sh installs Visual Studio Code on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Visual Studio Code
Comment=Installs Visual Studio Code on first use if needed, then starts it
Exec=/app/scripts/vscode.sh
Icon=accessories-text-editor
Terminal=false
Categories=X-UbuntuDesktop-Editors;
