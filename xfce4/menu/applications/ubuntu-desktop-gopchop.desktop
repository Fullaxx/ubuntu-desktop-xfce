# Applications > Ubuntu Desktop > AV (see ubuntu-desktop.menu)
# /app/scripts/gopchop.sh installs GOPchop on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=GOPchop
Comment=Installs GOPchop on first use if needed, then starts it
Exec=/app/scripts/gopchop.sh
Icon=video-x-generic
Terminal=false
Categories=X-UbuntuDesktop-AV;
