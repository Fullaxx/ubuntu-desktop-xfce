# Applications > Ubuntu Desktop > Utilities > Calculators (see ubuntu-desktop.menu)
# /app/scripts/galculator.sh installs Galculator on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Galculator
Comment=Installs Galculator on first use if needed, then starts it
Exec=/app/scripts/galculator.sh
Icon=accessories-calculator
Terminal=false
Categories=X-UbuntuDesktop-Calculators;
