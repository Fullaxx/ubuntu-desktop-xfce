# Applications > Ubuntu Desktop > Network > BitTorrent (see ubuntu-desktop.menu)
# /app/scripts/ktorrent.sh installs KTorrent on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=KTorrent
Comment=Installs KTorrent on first use if needed, then starts it
Exec=/app/scripts/ktorrent.sh
Icon=network-transmit-receive
Terminal=false
Categories=X-UbuntuDesktop-BitTorrent;
