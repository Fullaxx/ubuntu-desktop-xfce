# Applications > Ubuntu Desktop > Network > Chat (see ubuntu-desktop.menu)
# /app/scripts/srain.sh installs Srain on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Srain
Comment=Installs Srain on first use if needed, then starts it
Exec=/app/scripts/srain.sh
Icon=im-message-new
Terminal=false
Categories=X-UbuntuDesktop-Chat;
