# Applications > Ubuntu Desktop > Network > Browsers (see ubuntu-desktop.menu)
# /app/scripts/edge_beta.sh installs Microsoft Edge Beta on first use (xterm windows), then starts it
[Desktop Entry]
Type=Application
Name=Microsoft Edge Beta
Comment=Installs Microsoft Edge Beta on first use if needed, then starts it
Exec=/app/scripts/edge_beta.sh
Icon=web-browser
Terminal=false
Categories=X-UbuntuDesktop-Browsers;
